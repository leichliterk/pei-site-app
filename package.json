{
  "name": "pei-site-app",
  "version": "0.0.0",
  "main": "dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron-dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron-build": "ng build --configuration=electron && electron .",
    "dist": "ng build --configuration=electron && electron-builder",
    "dist-win": "ng build --configuration=electron && electron-builder --win",
    "electron:serve": "npm run electron:build && electron .",
    "electron:dev": "npm run electron:build && concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:pack": "npm run build:electron && electron-builder --dir",
    "electron:dist": "npm run build:electron && electron-builder",
    "electron:build:win": "ng build --configuration=electron && npm run electron:build && electron-builder --win",
    "electron:build:msi": "npm run electron:build:win && node build-msi.js"
  },
  "build": {
    "appId": "com.example.pei-site-app",
    "productName": "PEI Site App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/electron/**/*.map"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.1",
    "@angular/compiler": "^20.2.1",
    "@angular/core": "^20.2.1",
    "@angular/forms": "^20.2.1",
    "@angular/platform-browser": "^20.2.1",
    "@angular/platform-browser-dynamic": "^20.2.1",
    "@angular/router": "^20.2.1",
    "basic-ftp": "^5.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-wix-msi": "^5.1.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "wait-on": "^8.0.4"
  }
}
