{
  "name": "pei-site-service",
  "version": "1.0.0",
  "description": "PEI Site App Background Service - WebSocket connection and data relay",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "tsc && pkg . --targets node20-win-x64 --output ../release/pei-site-service.exe",
    "start": "node dist/index.js",
    "install-service": "node scripts/install-service.js",
    "uninstall-service": "node scripts/uninstall-service.js"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node20-win-x64"
    ]
  },
  "dependencies": {
    "basic-ftp": "^5.1.0",
    "express": "^4.18.2",
    "node-windows": "^1.0.0-beta.8",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@yao-pkg/pkg": "^5.12.0",
    "typescript": "^5.3.0"
  }
}
