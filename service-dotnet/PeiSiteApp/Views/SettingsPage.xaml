<UserControl x:Class="PeiSiteApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PeiSiteApp.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel Margin="16">
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <TabControl SelectedIndex="{Binding SelectedTabIndex}" TabStripPlacement="Left"
                            BorderThickness="0" Background="Transparent">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder"
                                                Background="Transparent"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                Cursor="Hand">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Site Configuration Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Site" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="24,16" MaxWidth="600">

                            <!-- Site Name -->
                            <TextBlock Text="Site Name" Style="{StaticResource FieldLabel}" />
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SaveSiteNameCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}" />
                            </DockPanel>

                            <!-- Site Name Message -->
                            <Border Margin="0,0,0,16" Padding="10,6" CornerRadius="4"
                                    Visibility="{Binding SiteNameMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SiteNameSuccess}" Value="True">
                                                <Setter Property="Background" Value="#F0FDF4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SiteNameSuccess}" Value="False">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SiteNameMessage}" FontSize="12" />
                            </Border>

                            <!-- API Key -->
                            <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SaveApiKeyCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputTextBox}" />
                            </DockPanel>

                            <!-- API Key Message -->
                            <Border Margin="0,0,0,16" Padding="10,6" CornerRadius="4"
                                    Visibility="{Binding ApiKeyMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ApiKeySuccess}" Value="True">
                                                <Setter Property="Background" Value="#F0FDF4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ApiKeySuccess}" Value="False">
                                                <Setter Property="Background" Value="#FEF2F2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ApiKeyMessage}" FontSize="12" />
                            </Border>

                            <!-- Separator -->
                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="0,8,0,24" />

                            <!-- Danger Zone -->
                            <Border BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="0">
                                <StackPanel>
                                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="8,8,0,0" Padding="16,12">
                                        <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="15" FontWeight="SemiBold">
                                            <Run Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" />
                                            <Run Text=" Danger Zone" />
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Margin="16">
                                        <TextBlock Text="Actions in this section WILL impact data collection and may result in permanent data loss."
                                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="Proceed with caution!" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,16" />

                                        <!-- Tenant ID -->
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right" Content="Edit Tenant ID"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding EditTenantIdCommand}" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="Current Tenant ID: " Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="{Binding TenantId, Mode=OneWay}" FontWeight="Bold" FontSize="15" />
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Site Number -->
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Edit Site Number"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding EditSiteNumberCommand}" />
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="Current Site Number: " Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="{Binding SiteNumber, Mode=OneWay}" FontWeight="Bold" FontSize="15" />
                                            </TextBlock>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Logging Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Logging" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="24,16" MaxWidth="500">
                            <TextBlock Text="Log Level" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Controls the minimum severity of messages written to the service log file."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="Apply" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveLogLevelCommand}" Margin="8,0,0,0" />
                                <ComboBox ItemsSource="{Binding LogLevels}"
                                          SelectedItem="{Binding SelectedLogLevel}"
                                          Padding="8,6" FontSize="13" Height="34" />
                            </DockPanel>

                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0369A1">
                                    <Run FontWeight="SemiBold" Text="debug" /> — all messages including detailed FTP protocol steps&#x0A;
                                    <Run FontWeight="SemiBold" Text="info" /> — normal operational messages (default)&#x0A;
                                    <Run FontWeight="SemiBold" Text="warning" /> — unexpected conditions that were handled&#x0A;
                                    <Run FontWeight="SemiBold" Text="error" /> — failures that need attention&#x0A;
                                    <Run FontWeight="SemiBold" Text="critical" /> — fatal errors only
                                </TextBlock>
                            </Border>

                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="0,16,0,8" />

                            <!-- Live Log header -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearLogsCommand}" />
                                <TextBlock Text="Live Log" FontWeight="Medium" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </DockPanel>

                            <!-- Log viewer -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                    Background="#FAFAFA">
                                <ScrollViewer x:Name="LogScrollViewer" Height="280"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LogEntries}" Padding="8,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="11"
                                                           TextWrapping="NoWrap" Margin="0,1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="debug">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="warn">
                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="error">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="crit">
                                                                    <Setter Property="Foreground" Value="#B91C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding ShortTimestamp, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Level, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Empty state (shown when no entries) -->
                            <TextBlock Text="Waiting for log entries..."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" FontStyle="Italic" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LogEntries.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </TabItem>

                    <!-- FTP Configuration Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="FTP" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="24,16" MaxWidth="600">
                            <TextBlock Text="FTP Sync Configuration" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <!-- Enable Toggle -->
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FtpEnabled}"
                                          VerticalAlignment="Center"
                                          Command="{Binding ToggleFtpEnabledCommand}" />
                                <StackPanel>
                                    <TextBlock Text="Enable FTP Auto-Sync" FontWeight="Medium" />
                                    <TextBlock Text="Automatically sync files from FTP servers on schedule"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                            <!-- Add FTP Server button -->
                            <Button Content="Add FTP Server" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenAddServerDialogCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16" />

                            <!-- Server list -->
                            <ItemsControl ItemsSource="{Binding FtpServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                        <Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                                                        <Run Text="{Binding Host, Mode=OneWay}" /><Run Text="{Binding Path, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="Interval: " /><Run Text="{Binding PollInterval, Mode=OneWay}" /><Run Text="s" />
                                                        <Run Text="  |  Last: " /><Run Text="{Binding LastResult, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.OpenEditServerDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Margin="0,0,6,0" />
                                                    <Button Content="Delete" Style="{StaticResource DangerButton}"
                                                            Command="{Binding DataContext.OpenDeleteDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state -->
                            <TextBlock Text="No FTP servers configured. Click 'Add FTP Server' to get started."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,4,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FtpServers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </TabItem>

                    <!-- Advanced Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Advanced" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="24,16" MaxWidth="600">
                            <TextBlock Text="Service Control" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PEI Site Service" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#6B7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsServiceRunning}" Value="True">
                                                                <Setter Property="Foreground" Value="#22C55E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ServiceStatusDisplay}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Working..." FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsServiceBusy, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Start Service" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding StartServiceCommand}"
                                                Visibility="{Binding IsServiceRunning, Converter={StaticResource InverseBoolToVis}}" />
                                        <Button Content="Stop Service" Style="{StaticResource DangerButton}"
                                                Command="{Binding StopServiceCommand}"
                                                Visibility="{Binding IsServiceRunning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Error message -->
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4" Background="#FEF2F2"
                                    Visibility="{Binding ServiceMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding ServiceMessage}" Foreground="{StaticResource DangerBrush}"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="0,16,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0369A1">
                                    Starting or stopping the service requires administrator privileges.
                                    If the operation fails, try running the app as administrator.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- PLC Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="PLC" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="24,16" MaxWidth="600">

                            <TextBlock Text="CompactLogix / ControlLogix" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="Configure EtherNet/IP polling for real-time SCADA data."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,16" />

                            <!-- Enable -->
                            <CheckBox IsChecked="{Binding PlcEnabled}" Content="Enable PLC polling"
                                      FontSize="14" Margin="0,0,0,16" />

                            <!-- IP Address -->
                            <TextBlock Text="PLC IP Address" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                            <!-- Slot and Interval side-by-side -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Backplane Slot" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PlcSlot, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Poll Interval (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding PlcPollingIntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}" />
                                </StackPanel>
                            </Grid>

                            <!-- Tags header -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="+ Add Tag"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding OpenAddPlcTagDialogCommand}" />
                                <TextBlock Text="Tags to Poll" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Tags list -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Margin="0,0,0,16" MinHeight="60">
                                <ItemsControl ItemsSource="{Binding PlcTags}" Padding="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,4,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DataType}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="4,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Unit}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="4,0" />
                                                <Button Grid.Column="4" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                        FontSize="11" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource TextSecondaryBrush}" Padding="4"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.OpenEditPlcTagDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="5" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        FontSize="11" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource DangerBrush}" Padding="4"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.RemovePlcTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcTags.Count, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate>
                                                                <TextBlock Text="No tags configured. Add tags to poll from the PLC."
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="12" Margin="12,12" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </Border>

                            <!-- Save -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcSaveMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlcSaveSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PlcSaveSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding PlcSaveMessage, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="Save PLC Settings"
                                        Command="{Binding SavePlcSettingsCommand}"
                                        HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlcIsSaving}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>

                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1"
                                    CornerRadius="4" Padding="12,10" Margin="0,16,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#0369A1">
                                    Changes are applied immediately — the service hot-reloads appsettings.json when saved.
                                    The PLC connection will reconnect on the next poll cycle.
                                </TextBlock>
                            </Border>

                        </StackPanel>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Tenant ID Dialog Overlay -->
        <Grid Visibility="{Binding ShowTenantDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="450" MaxHeight="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Tenant ID" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <TextBlock Text="Changing the tenant ID will affect which tenant this site belongs to."
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <TextBlock Text="New Tenant ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewTenantIdInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Type &quot;change tenant id&quot; to confirm" />
                    </TextBlock>
                    <TextBox Text="{Binding TenantConfirmationPhrase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding TenantErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,16"
                               Visibility="{Binding TenantErrorMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseTenantDialogCommand}" Margin="0,0,8,0" />
                        <Button Content="Confirm" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmTenantIdChangeCommand}"
                                IsEnabled="{Binding IsTenantFormValid}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Site Number Dialog Overlay -->
        <Grid Visibility="{Binding ShowSiteNumberDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="450" MaxHeight="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Edit Site Number" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <TextBlock Text="Changing the site number will fundamentally impact data collection."
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <TextBlock Text="New Site Number" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewSiteNumberInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <TextBlock Style="{StaticResource FieldLabel}">
                        <Run Text="Type &quot;change site number&quot; to confirm" />
                    </TextBlock>
                    <TextBox Text="{Binding ConfirmationPhrase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,16"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseDialogCommand}" Margin="0,0,8,0" />
                        <Button Content="Confirm" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmSiteNumberChangeCommand}"
                                IsEnabled="{Binding IsFormValid}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FTP Add/Edit Server Dialog -->
        <Grid Visibility="{Binding ShowFtpServerDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="500" MaxHeight="550"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding FtpDialogTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <!-- Server Name -->
                    <TextBlock Text="Server Name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DialogServerName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <!-- Host -->
                    <TextBlock Text="FTP Server Address" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DialogFtpHost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <!-- Path + Browse -->
                    <TextBlock Text="Folder Path" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenBrowseDialogCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DialogFtpPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}" />
                    </DockPanel>

                    <!-- Interval -->
                    <TextBlock Text="Sync Interval (seconds)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DialogFtpIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <!-- Full upload -->
                    <CheckBox IsChecked="{Binding DialogForceFullUpload}"
                              Content="Full upload on next poll (upload all files, regardless of date)"
                              Margin="0,0,0,16" />

                    <!-- Test / Status Message -->
                    <Border Padding="10,8" CornerRadius="4" Margin="0,0,0,12"
                            Visibility="{Binding DialogTestMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogTestSuccess}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DialogTestMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Test Connection" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DialogTestConnectionCommand}"
                                IsEnabled="{Binding DialogFtpHost, Converter={x:Static converters:StringNotEmptyConverter.Instance}}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseFtpServerDialogCommand}" Margin="0,0,8,0" />
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveFtpServerCommand}"
                                IsEnabled="{Binding IsFtpDialogSaveEnabled}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FTP Browse Dialog -->
        <Grid Visibility="{Binding ShowBrowseDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="500" MaxHeight="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Browse FTP Directories" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Loading indicator -->
                    <TextBlock DockPanel.Dock="Top" Text="Loading directories..."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding IsBrowseLoading, Converter={StaticResource BoolToVis}}" />

                    <!-- Error message -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding BrowseErrorMessage}"
                               Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding BrowseErrorMessage, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}" />

                    <!-- Action buttons at bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseBrowseDialogCommand}" Margin="0,0,8,0" />
                        <Button Content="Select" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SelectBrowsePathCommand}" />
                    </StackPanel>

                    <!-- Tree view -->
                    <TreeView ItemsSource="{Binding BrowseRoots}" BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}" Margin="0,4,0,0"
                              MinHeight="200"
                              SelectedItemChanged="BrowseTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- PLC Add Tag Dialog -->
        <Grid Visibility="{Binding ShowAddPlcTagDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding PlcTagDialogTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <TextBlock Text="Tag Name (PLC address)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewPlcTagName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="Data Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PlcDataTypes}"
                              SelectedItem="{Binding NewPlcTagDataType}"
                              Margin="0,0,0,12" Padding="8,6" />

                    <TextBlock Text="Display Name (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewPlcTagDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="Unit (optional, e.g. °F, PSI)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewPlcTagUnit, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding PlcTagDialogError}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding PlcTagDialogError, Converter={StaticResource NullToVisConverter}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseAddPlcTagDialogCommand}" Margin="0,0,8,0" />
                        <Button Command="{Binding ConfirmAddPlcTagCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Add" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlcTagDialogTitle}" Value="Edit PLC Tag">
                                            <Setter Property="Content" Value="Save" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FTP Delete Confirmation Dialog -->
        <Grid Visibility="{Binding ShowDeleteDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" />
            <Border Background="White" CornerRadius="8" MaxWidth="400" MaxHeight="250"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.2" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Delete FTP Server" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,20">
                        <Run Text="Are you sure you want to remove the FTP server " />
                        <Run Text="{Binding DeletingServerHost, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text="? This action cannot be undone." />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseDeleteDialogCommand}" Margin="0,0,8,0" />
                        <Button Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding ConfirmDeleteServerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
