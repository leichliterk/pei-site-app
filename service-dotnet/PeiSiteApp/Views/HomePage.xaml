<UserControl x:Class="PeiSiteApp.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:PeiSiteApp.Converters">

    <UserControl.Resources>
        <converters:ConnectionStatusToColorConverter x:Key="StatusToColor" />
        <converters:ConnectionStatusToBackgroundConverter x:Key="StatusToBackground" />
        <converters:ConnectionStatusToTextConverter x:Key="StatusToText" />
        <converters:BoolToServiceStatusConverter x:Key="BoolToServiceStatus" />
        <converters:BoolToServiceColorConverter x:Key="BoolToServiceColor" />
        <converters:FtpStatusToColorConverter x:Key="FtpStatusToColor" />
        <converters:FtpStatusToTextConverter x:Key="FtpStatusToText" />
        <converters:NullToDashConverter x:Key="NullToDash" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel HorizontalAlignment="Center" Width="650" Margin="0,24,0,24">

            <!-- Server Connection Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Server Connection" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Status Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Status" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                Background="{Binding WsStatus, Converter={StaticResource StatusToBackground}}">
                            <TextBlock Text="{Binding WsStatus, Converter={StaticResource StatusToText}}"
                                       Foreground="{Binding WsStatus, Converter={StaticResource StatusToColor}}"
                                       FontWeight="Medium" FontSize="12" />
                        </Border>
                    </Grid>

                    <!-- Background Service Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background Service" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                Background="{Binding IsServiceRunning, Converter={StaticResource BoolToServiceColor}, ConverterParameter=bg}">
                            <TextBlock Text="{Binding IsServiceRunning, Converter={StaticResource BoolToServiceStatus}}"
                                       Foreground="{Binding IsServiceRunning, Converter={StaticResource BoolToServiceColor}}"
                                       FontWeight="Medium" FontSize="12" />
                        </Border>
                    </Grid>

                    <!-- Connection Source Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Connection Source" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionSource}" FontWeight="Medium" />
                    </Grid>

                    <!-- Connected At Row -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Connected At" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ConnectedAtText}" FontWeight="Medium" />
                    </Grid>

                    <!-- Uptime Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current Uptime" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentUptime}" FontWeight="Medium" FontFamily="Consolas" />
                    </Grid>

                    <!-- Chart Section -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Connection History (Last 5 minutes)"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" />
                            <lvc:CartesianChart Series="{Binding ChartSeries}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                Height="120"
                                                TooltipPosition="Hidden"
                                                AnimationsSpeed="00:00:00" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- FTP Status Card -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="FTP Status" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Status" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                Background="Transparent" Cursor="Hand">
                            <TextBlock Text="{Binding FtpStatusText}"
                                       Foreground="{Binding FtpStatus, Converter={StaticResource FtpStatusToColor}}"
                                       FontWeight="Medium" FontSize="12" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
