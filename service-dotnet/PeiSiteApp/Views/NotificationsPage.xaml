<UserControl x:Class="PeiSiteApp.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NotificationRow" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Read}" Value="False">
                    <Setter Property="Background" Value="#EFF6FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeAccent" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2,0,0,2" />
            <Setter Property="Background" Value="#64748B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="info">
                    <Setter Property="Background" Value="#3B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="warning">
                    <Setter Property="Background" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="error">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="success">
                    <Setter Property="Background" Value="#22C55E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Panel.ZIndex="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#64748B" FontSize="14" />
        </Border>

        <!-- OTA dialog overlay -->
        <Border Background="#99000000" Panel.ZIndex="20"
                Visibility="{Binding ShowOtaDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="32"
                    MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.3" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Icon + title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="Software Update Available" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1E293B" />
                            <TextBlock Text="{Binding OtaVersion}" FontSize="13" Foreground="#64748B"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Notes -->
                    <TextBlock Text="{Binding OtaNotes}" FontSize="13" Foreground="#475569"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding OtaNotes, Converter={StaticResource BoolToVis}}" />

                    <!-- Size -->
                    <TextBlock FontSize="12" Foreground="#94A3B8" Margin="0,0,0,20">
                        <Run Text="Download size: " />
                        <Run Text="{Binding OtaSizeDisplay, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Confirm state: Install / Later buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OtaStatus}" Value="confirm">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding OtaDeclineCommand}" Margin="0,0,8,0"
                                Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                Padding="16,8" Cursor="Hand" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Later" Foreground="#64748B" />
                        </Button>
                        <Button Command="{Binding OtaAcceptCommand}"
                                Background="#3B82F6" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Install Now" Foreground="White" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>

                    <!-- Downloading state: progress bar -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OtaStatus}" Value="downloading">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding OtaStatusMessage}" FontSize="13" Foreground="#475569"
                                   Margin="0,0,0,10" />
                        <ProgressBar Value="{Binding OtaDownloadProgress}" Maximum="100"
                                     Height="8" Background="#E2E8F0" Foreground="#3B82F6" />
                    </StackPanel>

                    <!-- Launching state -->
                    <TextBlock Foreground="#22C55E" FontSize="13" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OtaStatus}" Value="launching">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="&#xE73E;  " FontFamily="Segoe MDL2 Assets" />
                        <Run Text="{Binding OtaStatusMessage}" />
                    </TextBlock>

                    <!-- Error state -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OtaStatus}" Value="error">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding OtaStatusMessage}" Foreground="#EF4444"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Button Command="{Binding OtaDeclineCommand}"
                                Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                Padding="12,6" Cursor="Hand" FontSize="12" HorizontalAlignment="Right">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Close" Foreground="#64748B" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Release notes dialog overlay -->
        <Border Background="#99000000" Panel.ZIndex="30"
                Visibility="{Binding ShowReleaseNotesDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="8" Padding="32"
                    MaxWidth="520" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.3" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <!-- Header row -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseReleaseNotesDialogCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#94A3B8" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Release Notes" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#1E293B" />
                            <TextBlock Text="{Binding ReleaseNotesVersion}" FontSize="13" Foreground="#64748B"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Close button (bottom) -->
                    <Button DockPanel.Dock="Bottom" Command="{Binding CloseReleaseNotesDialogCommand}"
                            HorizontalAlignment="Right" Margin="0,16,0,0"
                            Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                            Padding="16,8" Cursor="Hand" FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Close" Foreground="#64748B" />
                    </Button>

                    <!-- Notes content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotesText}" FontSize="13" Foreground="#475569"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <DockPanel>
                    <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Command="{Binding MarkAllReadCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}" Padding="12,6">
                        <TextBlock Text="Mark All Read" FontSize="12" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Notifications list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}"
                               HorizontalAlignment="Center" Foreground="#64748B"
                               FontSize="14" Margin="0,48,0,0" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NotificationRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource TypeAccent}"
                                                Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="●" Foreground="#3B82F6" FontSize="8"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           DockPanel.Dock="Left">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Read}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           FontSize="13" Foreground="#1E293B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Body}" FontSize="12"
                                                       Foreground="#64748B" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ReceivedAt}" FontSize="11"
                                                       Foreground="#94A3B8" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Action buttons column -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">

                                            <!-- OTA: Release notes link (only for OTA notifications with notes) -->
                                            <Button Command="{Binding DataContext.OpenReleaseNotesDialogCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="6,5" Cursor="Hand" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOtaNotes}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="Release notes" FontSize="11"
                                                           Foreground="#3B82F6" TextDecorations="Underline" />
                                            </Button>

                                            <!-- OTA: Install Update button (only for OTA notifications) -->
                                            <Button Command="{Binding DataContext.OpenOtaDialogCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#3B82F6" BorderThickness="0"
                                                    Padding="10,5" Cursor="Hand" Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOta}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" Foreground="White"
                                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="Install Update" FontSize="11"
                                                               Foreground="White" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Mark read button (hidden for OTA, shown for regular unread) -->
                                            <Button Command="{Binding DataContext.MarkReadCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Mark as read"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="6">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Read}" Value="False" />
                                                                    <Condition Binding="{Binding IsOta}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="#64748B" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
