<UserControl x:Class="PeiSiteApp.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Notification row style — unread rows have a subtle blue-tinted background -->
        <Style x:Key="NotificationRow" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Read}" Value="False">
                    <Setter Property="Background" Value="#EFF6FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Type accent bar color -->
        <Style x:Key="TypeAccent" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2,0,0,2" />
            <Setter Property="Background" Value="#64748B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="info">
                    <Setter Property="Background" Value="#3B82F6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="warning">
                    <Setter Property="Background" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="error">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="success">
                    <Setter Property="Background" Value="#22C55E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#64748B" FontSize="14" />
        </Border>

        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <DockPanel>
                    <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Command="{Binding MarkAllReadCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,6">
                        <TextBlock Text="Mark All Read" FontSize="12" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Empty state -->
            <Border DockPanel.Dock="Bottom" Padding="32"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock />
            </Border>

            <!-- Notifications list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Empty state message (shown when no notifications) -->
                    <TextBlock Text="{Binding EmptyMessage}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#64748B" FontSize="14" Margin="0,48,0,0"
                               FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource NotificationRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Type accent bar -->
                                        <Border Grid.Column="0" Style="{StaticResource TypeAccent}"
                                                Margin="0,0,12,0" />

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="●" Foreground="#3B82F6" FontSize="8"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           DockPanel.Dock="Left">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Read}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           FontSize="13" Foreground="#1E293B"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Body}" FontSize="12"
                                                       Foreground="#64748B" TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ReceivedAt}" FontSize="11"
                                                       Foreground="#94A3B8" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <!-- Mark read button -->
                                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Command="{Binding DataContext.MarkReadCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Mark as read"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Padding="6">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Read}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="#64748B" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
