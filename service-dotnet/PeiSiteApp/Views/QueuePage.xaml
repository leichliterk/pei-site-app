<UserControl x:Class="PeiSiteApp.Views.QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PeiSiteApp.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Status pill background by status string -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="#64748B" />
        </Style>

        <!-- Row accent bar -->
        <Style x:Key="AccentBar" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2,0,0,2" />
            <Setter Property="Background" Value="#64748B" />
        </Style>

        <!-- Subtle action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Upload Queue" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <!-- Broker status indicator -->
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#22C55E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Fill" Value="#F59E0B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" Foreground="#64748B">
                            <Run Text="{Binding BrokerStatusText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding PendingCount, Mode=OneWay}" />
                            <Run Text=" pending" />
                        </TextBlock>
                        <!-- In-flight indicator -->
                        <TextBlock FontSize="12" Foreground="#3B82F6" Margin="10,0,0,0"
                                   Visibility="{Binding IsInFlight, Converter={StaticResource BoolToVis}}">
                            · Sending…
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionBtn}" Margin="0,0,8,0"
                            Command="{Binding PauseResumeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE769;" /> <!-- Pause -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="&#xE768;" /> <!-- Play -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PauseResumeLabel}" Foreground="#374151" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}" Margin="0,0,8,0"
                            Command="{Binding ClearHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Clear History" Foreground="#374151" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Refresh" Foreground="#374151" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error / empty message -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center" Margin="0,16,0,0"
                   Foreground="#EF4444" FontSize="13"
                   Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}" />

        <!-- Column headers -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />   <!-- accent bar -->
                    <ColumnDefinition Width="12" />  <!-- gap -->
                    <ColumnDefinition Width="2*" />  <!-- filename -->
                    <ColumnDefinition Width="*" />   <!-- source -->
                    <ColumnDefinition Width="80" />  <!-- size -->
                    <ColumnDefinition Width="90" />  <!-- status -->
                    <ColumnDefinition Width="130" /> <!-- queued -->
                    <ColumnDefinition Width="130" /> <!-- sent/ack -->
                    <ColumnDefinition Width="80" />  <!-- actions -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="Filename"   FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="3" Text="Source"     FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="4" Text="Size"       FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="5" Text="Status"     FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="6" Text="Queued"     FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                <TextBlock Grid.Column="7" Text="Sent / Ack" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
            </Grid>
        </Border>

        <!-- Queue list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Accent bar (colour by status) -->
                                <Border Grid.Column="0" CornerRadius="2,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#64748B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="success">
                                                    <Setter Property="Background" Value="#22C55E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="sending">
                                                    <Setter Property="Background" Value="#3B82F6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="retrying">
                                                    <Setter Property="Background" Value="#F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="permanentlyFailed">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Filename + error tooltip -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Filename}" FontSize="13" Foreground="#1E293B"
                                               TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LastError}" FontSize="11" Foreground="#EF4444"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="permanentlyFailed">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="retrying">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Source -->
                                <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="12"
                                           Foreground="#475569" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Size -->
                                <TextBlock Grid.Column="4" FontSize="12" Foreground="#64748B"
                                           VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="SizeBytes" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Status pill -->
                                <Border Grid.Column="5" VerticalAlignment="Center"
                                        CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="success">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="sending">
                                                    <Setter Property="Background" Value="#DBEAFE" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="retrying">
                                                    <Setter Property="Background" Value="#FEF3C7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="permanentlyFailed">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Pending" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="success">
                                                        <Setter Property="Text" Value="Success" />
                                                        <Setter Property="Foreground" Value="#15803D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="sending">
                                                        <Setter Property="Text" Value="Sending" />
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="retrying">
                                                        <Setter Property="Text" Value="Retrying" />
                                                        <Setter Property="Foreground" Value="#B45309" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="permanentlyFailed">
                                                        <Setter Property="Text" Value="Failed" />
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Queued timestamp -->
                                <TextBlock Grid.Column="6" Text="{Binding QueuedAt}" FontSize="11"
                                           Foreground="#94A3B8" VerticalAlignment="Center" />

                                <!-- Sent / Ack timestamp (whichever is available) -->
                                <TextBlock Grid.Column="7" FontSize="11" Foreground="#94A3B8"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding AckAt}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AckAt}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding SentAt}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Retry button (only for permanentlyFailed) -->
                                <Button Grid.Column="8" VerticalAlignment="Center"
                                        Command="{Binding DataContext.RetryCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#3B82F6" BorderThickness="0"
                                        Padding="8,4" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="permanentlyFailed">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="Retry" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Button>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
