<UserControl x:Class="PeiSiteApp.Views.ScadaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PeiSiteApp.ViewModels">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TagCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- Header bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="SCADA / PLC Live View" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,5,0"
                                 Fill="{Binding ConnectionColor}" />
                        <TextBlock FontSize="12" Foreground="#64748B">
                            <Run Text="{Binding ConnectionStatus, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding IpAddress, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdated, Mode=OneWay}" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ActionBtn}">
                        <TextBlock Text="Refresh" FontSize="12" Foreground="#334155" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status message (disabled / error) — hidden when empty -->
        <Border DockPanel.Dock="Top" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="0,0,0,1"
                Padding="24,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#92400E" FontSize="13" />
        </Border>

        <!-- Tag grid -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TagCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <!-- Tag label + name -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1E293B" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#94A3B8"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Value + unit -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ValueDisplay}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E293B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Unit — hidden when null/empty -->
                                    <TextBlock Text="{Binding Unit}" FontSize="11" Foreground="#64748B"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Unit}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Unit}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Data type badge -->
                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4"
                                        Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding DataType}" FontSize="11" Foreground="#64748B" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
