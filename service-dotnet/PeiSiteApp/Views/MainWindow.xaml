<Window x:Class="PeiSiteApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PeiSiteApp.ViewModels"
        xmlns:views="clr-namespace:PeiSiteApp.Views"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationsViewModel}">
            <views:NotificationsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}">
            <views:QueuePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScadaViewModel}">
            <views:ScadaPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagBrowserViewModel}">
            <views:TagBrowserPage />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarGradient}" Padding="16,10">
            <DockPanel>
                <!-- Left: Title and site info -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="PEI Data Services" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Foreground="#BBD5F8" FontSize="12" Margin="0,2,0,0">
                        <Run Text="Site: " />
                        <Run Text="{Binding SiteNumber}" />
                        <Run Text=" - " />
                        <Run Text="{Binding SiteName}" />
                        <Run Text=" - " />
                        <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Right: Navigation buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateHomeCommand}"
                            ToolTip="Home" Margin="0,0,4,0">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                    <!-- Queue button -->
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateQueueCommand}"
                            ToolTip="Upload Queue" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                            <!-- Pending badge -->
                            <Border Background="#F59E0B" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    MinWidth="16" Height="16" Padding="3,0"
                                    Margin="0,-4,-4,0"
                                    Visibility="{Binding HasPendingQueue, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding QueuePendingDisplay}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <!-- SCADA Live View button -->
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateScadaCommand}"
                            ToolTip="SCADA / PLC Live View" Margin="0,0,4,0">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                    <!-- Tag Browser button -->
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateTagBrowserCommand}"
                            ToolTip="PLC Tag Browser" Margin="0,0,4,0">
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateNotificationsCommand}"
                            ToolTip="Notifications" Margin="0,0,4,0">
                        <Grid>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                            <!-- Unread badge -->
                            <Border Background="#EF4444" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    MinWidth="16" Height="16" Padding="3,0"
                                    Margin="0,-4,-4,0"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadNotificationDisplay}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NavigateSettingsCommand}"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page Content -->
        <ContentControl Content="{Binding CurrentPage}" Margin="0" />
    </DockPanel>
</Window>
